# Root .env — used by `docker compose` (all platforms)
# Copy to .env or backend/.env — both are loaded via env_file (cross-platform)
# Windows: copy .env.example .env   |  macOS/Linux: cp .env.example .env

DB_USER=admin
DB_PASSWORD=admin
DB_NAME=mydb
DB_PORT=5432
JWT_SECRET=change_me_to_a_random_32_char_secret_min
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
