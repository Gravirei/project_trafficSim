{
  "name": "traffic-simulation-project",
  "version": "1.0.0",
  "description": "Root configuration to run full stack simultaneously",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "db:up": "docker compose -f postgres-setup/docker-compose.yml up -d",
    "db:down": "docker compose -f postgres-setup/docker-compose.yml down",
    "db:up:wait": "docker compose -f postgres-setup/docker-compose.yml up -d --wait",
    "start:backend": "npm run dev --workspace=backend",
    "start:frontend": "npm run dev --workspace=frontend",
    "dev": "node scripts/dev.mjs",
    "dev:legacy": "npm run db:up && concurrently -c \"cyan,magenta\" -n \"BACKEND,FRONTEND\" \"npm run start:backend\" \"npm run start:frontend\"",
    "dev:docker": "docker compose up --build",
    "dev:docker:down": "docker compose down",
    "stop": "npm run db:down",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx,js,jsx,mjs,cjs}": [
      "bash -c 'cd frontend && npx eslint --fix --max-warnings 0'",
      "prettier --write"
    ],
    "backend/src/**/*.{ts,tsx,js,jsx,mjs,cjs}": [
      "bash -c 'cd backend && npx eslint --fix --max-warnings 0'",
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.6.0"
  }
}
